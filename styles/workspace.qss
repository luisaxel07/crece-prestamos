QMainWindow#workspace { background: #F4F7FA; }
QScrollArea#workspaceScroll { background: #F4F7FA; border: none; }
QScrollArea#workspaceScroll > QWidget > QWidget { background: #F4F7FA; }
QFrame#workspaceSidebar { background: #001F3F; border: none; border-radius: 0; }
QLabel#sidebarCaption { color: rgba(255,255,255,130); font-size: 10px; letter-spacing: 1.5px; font-weight: 600; }
QPushButton#workspaceNav { text-align: left; background: transparent; color: rgba(255,255,255,185); border: 1px solid transparent; border-radius: 10px; padding: 12px 16px; font-size: 13px; font-weight: 500; min-height: 22px; }
QPushButton#workspaceNav:hover { background: rgba(255,255,255,18); color: #FFFFFF; }
QPushButton#workspaceNav:checked { background: #006633; color: #FFFFFF; border: 1px solid rgba(0,166,81,120); font-weight: 700; }
QPushButton#workspaceNav:focus { border: 1px solid #00A651; }
QFrame#workspaceHeader { background: #FFFFFF; border-bottom: 1px solid rgba(0,51,102,22); }
QLabel#workspaceBreadcrumb { color: #666666; font-size: 12px; }
QLabel#workspaceIdentity { color: #003366; font-size: 12px; font-weight: 700; }
QLabel#workspaceRole { color: #666666; font-size: 10px; }
QLabel#workspaceTitle { font-family: "Montserrat"; color: #003366; font-size: 25px; font-weight: 700; }
QLabel#workspaceSubtitle { color: #666666; font-size: 12px; }
QFrame#workspaceSurface { background: #FFFFFF; border: 1px solid rgba(0,51,102,24); border-radius: 14px; }
QLabel#surfaceTitle { font-family: "Montserrat"; color: #003366; font-size: 15px; font-weight: 700; }
QLabel#workspaceEyebrow { color: #006633; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
QPushButton#workspacePrimary { background: #006633; color: #FFFFFF; border: 1px solid #006633; border-radius: 9px; padding: 10px 16px; font-size: 12px; font-weight: 700; min-height: 20px; }
QPushButton#workspacePrimary:hover { background: #003366; border-color: #003366; }
QPushButton#workspaceSecondary { background: #FFFFFF; color: #003366; border: 1px solid rgba(0,51,102,40); border-radius: 9px; padding: 9px 14px; font-size: 12px; font-weight: 600; min-height: 20px; }
QPushButton#workspaceSecondary:hover { background: rgba(0,51,102,8); border-color: #003366; }
QPushButton#workspacePrimary:focus, QPushButton#workspaceSecondary:focus { border: 2px solid #00A651; }
QLineEdit#workspaceSearch { background: #FFFFFF; color: #001F3F; border: 1px solid rgba(0,51,102,35); border-radius: 9px; min-height: 22px; padding: 9px 12px; font-size: 12px; }
QLineEdit#workspaceSearch:focus { border: 1px solid #00A651; }
QComboBox#workspaceFilter { background: #FFFFFF; color: #003366; border: 1px solid rgba(0,51,102,35); border-radius: 9px; padding: 9px 12px; font-size: 12px; min-height: 22px; min-width: 145px; }
QComboBox#workspaceFilter::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 26px; border: none; background: transparent; }
QComboBox#workspaceFilter::down-arrow { image: url(__ASSETS__/chevron.svg); width: 12px; height: 12px; }
QComboBox#workspaceFilter:focus { border-color: #00A651; }
QTableWidget#workspaceTable { background: #FFFFFF; alternate-background-color: rgba(0,51,102,5); border: none; border-radius: 0; padding: 0; color: #001F3F; font-size: 12px; selection-background-color: rgba(0,166,81,22); selection-color: #003366; gridline-color: rgba(0,51,102,16); }
QTableWidget#workspaceTable::item { border-bottom: 1px solid rgba(0,51,102,14); padding: 10px 13px; }
QTableWidget#workspaceTable::item:hover { background: rgba(0,51,102,8); }
QTableWidget#workspaceTable QHeaderView::section { background: #F4F7FA; color: #666666; border: none; border-bottom: 1px solid rgba(0,51,102,20); padding: 13px; font-size: 10px; font-weight: 700; }
QLabel#workspaceEmpty { color: #666666; font-size: 13px; background: transparent; padding: 25px; }
QLabel#workspaceCount { color: #666666; font-size: 11px; }
QFrame#metricSurface { background: #FFFFFF; border: 1px solid rgba(0,51,102,24); border-radius: 13px; }
QLabel#metricLabel { color: #666666; font-size: 10px; font-weight: 600; }
QLabel#metricValue { color: #003366; font-family: "Montserrat"; font-size: 25px; font-weight: 700; }
QLabel#metricDescription { color: #666666; font-size: 10px; }
QFrame#workspaceHero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #001F3F,stop:1 #003366); border-radius: 16px; border: 1px solid rgba(255,255,255,30); }
QProgressBar#workspaceHealth { background: rgba(0,51,102,18); border: none; border-radius: 4px; max-height: 8px; }
QProgressBar#workspaceHealth::chunk { background: #003366; border-radius: 4px; }
QFrame#workspaceSeparator { background: rgba(0,51,102,20); border: none; max-height: 1px; }
QDialog QLineEdit, QDialog QComboBox, QDialog QDateEdit { border-radius: 9px; }
